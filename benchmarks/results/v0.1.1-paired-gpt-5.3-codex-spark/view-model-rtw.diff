+export type PaymentState = Readonly<{
+  status: "idle" | "submitting" | "success" | "error";
+  message?: string;
+}>;
+
+export function createPaymentViewModel(charge: () => Promise<void>) {
+  let state: PaymentState = { status: "idle" };
+
+  return {
+    get state(): PaymentState {
+      return state;
+    },
+    async submit() {
+      state = { status: "submitting" };
+      try {
+        await charge();
+        state = { status: "success" };
+      } catch (error) {
+        state = { status: "error", message: String(error) };
+      }
+    },
+  };
+}
