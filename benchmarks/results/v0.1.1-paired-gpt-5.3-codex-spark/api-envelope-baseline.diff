@@ -0,0 +1,8 @@
+from .responses import failure, ok
+
+
+def get_invoice(repository, invoice_id):
+    invoice = repository.find(invoice_id)
+    if invoice is None:
+        return failure("invoice_not_found", "Invoice not found")
+    return ok(invoice)
